{
  "name": "@templify/cli",
  "version": "1.0.0",
  "description": "Fill DOCX templates from command-line values, CSV, and XLSX.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-coding/templify.git",
    "directory": "apps/cli"
  },
  "bin": {
    "templify": "dist/index.js"
  },
  "files": [
    "dist",
    "README.zh-CN.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.config.json --pretty false"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "gunshi": "^0.37.3",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@templify/core": "workspace:*",
    "@templify/node-output": "workspace:*",
    "@templify/tabular-input": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
