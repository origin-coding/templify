{
  "name": "@templify/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "templify": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.config.json --pretty false"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "gunshi": "^0.37.3",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@templify/core": "workspace:*",
    "@templify/node-output": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
