{
  "name": "@templify/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": ".desktop/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "nuxt prepare && tsc --noEmit -p tsconfig.desktop.json && tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.renderer.json"
  },
  "devDependencies": {
    "@tdesign-vue-next/nuxt": "^0.2.2",
    "@templify/core": "workspace:*",
    "@templify/node-output": "workspace:*",
    "@types/node": "catalog:",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "nuxt": "^4.5.2",
    "tdesign-vue-next": "^1.20.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "io.github.origin-coding.templify",
    "productName": "Templify",
    "directories": {
      "output": "release"
    },
    "files": [
      ".desktop/main/**",
      ".desktop/preload/**",
      ".desktop/renderer/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
