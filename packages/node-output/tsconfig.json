{
  "extends": "../../tsconfig.bundler.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "paths": {
      "@/*": ["./src/*", "../core/src/*"],
      "@templify/core": ["../core/src/index.ts"]
    },
    "types": ["node"],
    "declaration": true,
    "isolatedDeclarations": true
  },
  "include": ["src/**/*.ts", "../core/src/types/**/*.d.ts"]
}
